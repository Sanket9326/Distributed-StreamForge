{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "upload-route": {
        "ClusterId": "upload-cluster",
        "Match": {
          "Path": "/api/uploads/{**remainder}"
        }
      },
      "feed-route": {
        "ClusterId": "feed-cluster",
        "Match": {
          "Path": "/api/feed/{**remainder}"
        }
      }
    },
    "Clusters": {
      "upload-cluster": {
        "Destinations": {
          "upload-service": {
            "Address": "http://localhost:5081/"
          }
        }
      },
      "feed-cluster": {
        "Destinations": {
          "feed-service": {
            "Address": "http://localhost:5082/"
          }
        }
      }
    }
  }
}
