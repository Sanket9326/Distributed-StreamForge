{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UploadDatabase": ""
  },
  "Upload": {
    "MaxFileSizeBytes": 1073741824
  },
  "ObjectStorage": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "streamforge-videos",
    "UseSsl": false
  },
  "Kafka": {
    "BootstrapServers": "",
    "TopicName": "video-processing",
    "PartitionCount": 1,
    "ReplicationFactor": 1,
    "InitializationTimeoutSeconds": 60
  },
  "Outbox": {
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 20,
    "MaximumRetryDelaySeconds": 60,
    "DegradedAfterSeconds": 300
  }
}
