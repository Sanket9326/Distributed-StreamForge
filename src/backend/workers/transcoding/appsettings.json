{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TranscodingDatabase": ""
  },
  "Kafka": {
    "BootstrapServers": "",
    "ConsumerGroupId": "streamforge-transcoding-v1",
    "InputTopic": "video-processing",
    "CompletedTopic": "video-transcoding-completed",
    "FailedTopic": "video-transcoding-failed",
    "DeadLetterTopic": "video-processing-dead-letter",
    "PartitionCount": 1,
    "ReplicationFactor": 1,
    "InitializationTimeoutSeconds": 60
  },
  "ObjectStorage": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "RenditionsBucket": "streamforge-renditions",
    "UseSsl": false
  },
  "Transcoding": {
    "MaxConcurrentJobs": 1,
    "MaxAttempts": 5,
    "PollIntervalMilliseconds": 1000,
    "LeaseDurationSeconds": 120,
    "LeaseHeartbeatSeconds": 30,
    "RetryBaseDelaySeconds": 30,
    "RetryMaximumDelaySeconds": 900,
    "JobTimeoutSeconds": 21600,
    "ScratchPath": "/tmp/streamforge-transcoding",
    "MinimumFreeScratchBytes": 2147483648,
    "HlsSegmentDurationSeconds": 4,
    "AssetUploadConcurrency": 4
  },
  "MediaTools": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  },
  "Outbox": {
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 20,
    "MaximumRetryDelaySeconds": 60
  }
}
