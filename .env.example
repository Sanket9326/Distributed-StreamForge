# Copy this file to .env and replace every placeholder before starting Compose.
STREAMFORGE_POSTGRES_DATABASE=streamforge_upload
STREAMFORGE_POSTGRES_USER=streamforge
STREAMFORGE_POSTGRES_PASSWORD=replace-with-a-local-postgres-password
STREAMFORGE_PGADMIN_EMAIL=admin@streamforge.dev
STREAMFORGE_MINIO_ACCESS_KEY=streamforge-local
STREAMFORGE_MINIO_SECRET_KEY=replace-with-a-local-minio-secret
